ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=1
ZETARIS_AUTH_MODE=login
ZETARIS_USERNAME=your-zetaris-username
ZETARIS_PASSWORD=your-zetaris-password
ZETARIS_API_KEY=your-zetaris-api-key
LLM_PROVIDER=meterless   # meterless (Nightshift, primary) | ollama (local development only)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=nemotron-3.5-super
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
METERLESS_MODEL_SUPER=nvidia/nemotron-3.5-super-vl-120b-a12b
METERLESS_MODEL_LIGHTNING=meterless/text.fast
# off | tools. "tools" sends plain requests with an inert tool so Nightshift serves them directly (see npm run check:routing)
METERLESS_DIRECT_MODE=tools
# Judging steps (CriticAgent): a model id or a route such as meterless/judge; empty = Lightning
METERLESS_MODEL_JUDGE=meterless/text.fusion
# single | per-agent. per-agent shows one Nightshift app stream per agent (diamondagentiq-critic, ...)
METERLESS_APP_STREAMS=per-agent
SAMPLE_MODE=false
DIQ_PG_PASSWORD=your-diq-postgres-password

# H-MEM memory (local only; gitignored)
DIQ_MEMORY_DIR=memory
